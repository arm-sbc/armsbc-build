+	RK3562_CLK_DUMP(PLL_DPLL, "dpll"),
+	RK3562_CLK_DUMP(ACLK_BUS, "aclk_bus"),
+	RK3562_CLK_DUMP(HCLK_BUS, "hclk_bus"),
+	RK3562_CLK_DUMP(PCLK_BUS, "pclk_bus"),
+	RK3562_CLK_DUMP(ACLK_PERI, "aclk_peri"),
