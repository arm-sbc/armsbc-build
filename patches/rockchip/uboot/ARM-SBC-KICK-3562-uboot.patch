+	assert(div - 1 <= 255);
+	rk_clrsetreg(&cru->periclksel_con[20],
+		     SCLK_SFC_SEL_MASK | SCLK_SFC_DIV_MASK,
+		     sel << SCLK_SFC_SEL_SHIFT |
