+	regmap_read(bsp_priv->php_grf, RK3562_GRF_IOC_GMAC_IOFUNC0_CON1, &iof0c1);
+	regmap_read(bsp_priv->php_grf, RK3562_GRF_IOC_GMAC_IOFUNC1_CON0, &iof1c0);
+	regmap_read(bsp_priv->php_grf, RK3562_GRF_IOC_GMAC_IOFUNC1_CON1, &iof1c1);
+
+	dev_info(bsp_priv->dev,
+		 "RK3562 GMAC %s: id=%d iface=%d clock_input=%d sys0=0x%08x sys1=0x%08x iof0c0=0x%08x iof0c1=0x%08x iof1c0=0x%08x iof1c1=0x%08x\n",
+		 where, bsp_priv->id, bsp_priv->phy_iface, bsp_priv->clock_input,
+		 sys0, sys1, iof0c0, iof0c1, iof1c0, iof1c1);
+}
+
+static void rk3562_set_to_rgmii(struct rk_priv_data *bsp_priv,
+				int tx_delay, int rx_delay)
+{
+	if (bsp_priv->id > 0)
+		return;
+
+	regmap_write(bsp_priv->grf, RK3562_GRF_SYS_SOC_CON0,
+		     RK3562_GMAC0_CLK_RGMII_MODE);
+
+	regmap_write(bsp_priv->php_grf, RK3562_GRF_IOC_GMAC_IOFUNC0_CON1,
+		     DELAY_ENABLE(RK3562, tx_delay, rx_delay));
+	regmap_write(bsp_priv->php_grf, RK3562_GRF_IOC_GMAC_IOFUNC0_CON0,
+		     RK3562_GMAC_CLK_RX_DL_CFG(rx_delay) |
+		     RK3562_GMAC_CLK_TX_DL_CFG(tx_delay));
+
+	regmap_write(bsp_priv->php_grf, RK3562_GRF_IOC_GMAC_IOFUNC1_CON1,
+		     DELAY_ENABLE(RK3562, tx_delay, rx_delay));
+	regmap_write(bsp_priv->php_grf, RK3562_GRF_IOC_GMAC_IOFUNC1_CON0,
+		     RK3562_GMAC_CLK_RX_DL_CFG(rx_delay) |
+		     RK3562_GMAC_CLK_TX_DL_CFG(tx_delay));
+
+	rk3562_dump_regs(bsp_priv, "after rgmii");
+}
+
+static void rk3562_set_to_rmii(struct rk_priv_data *bsp_priv)
+{
+	if (bsp_priv->id == 0)
+		regmap_write(bsp_priv->grf, RK3562_GRF_SYS_SOC_CON0,
+			     RK3562_GMAC0_CLK_RMII_MODE);
+
+	rk3562_dump_regs(bsp_priv, "after rmii");
+}
+
+static int rk3562_set_speed(struct rk_priv_data *bsp_priv,
+			    phy_interface_t interface, int speed)
+{
+	unsigned int val, offset;
+
+	switch (speed) {
+	case SPEED_10:
+		if (interface == PHY_INTERFACE_MODE_RMII) {
+			if (bsp_priv->id > 0) {
+				val = RK3562_GMAC1_CLK_RMII_DIV20;
+				regmap_write(bsp_priv->grf, RK3562_GRF_SYS_SOC_CON0,
+					     RK3562_GMAC1_RMII_SPEED10);
+			} else {
+				val = RK3562_GMAC0_CLK_RMII_DIV20;
+			}
+		} else {
+			val = RK3562_GMAC0_CLK_RGMII_DIV50;
+		}
+		break;
+	case SPEED_100:
+		if (interface == PHY_INTERFACE_MODE_RMII) {
+			if (bsp_priv->id > 0) {
+				val = RK3562_GMAC1_CLK_RMII_DIV2;
+				regmap_write(bsp_priv->grf, RK3562_GRF_SYS_SOC_CON0,
+					     RK3562_GMAC1_RMII_SPEED100);
+			} else {
+				val = RK3562_GMAC0_CLK_RMII_DIV2;
+			}
+		} else {
+			val = RK3562_GMAC0_CLK_RGMII_DIV5;
+		}
+		break;
+	case SPEED_1000:
+		if (interface == PHY_INTERFACE_MODE_RMII)
+			return -EINVAL;
+		val = RK3562_GMAC0_CLK_RGMII_DIV1;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	offset = bsp_priv->id > 0 ? RK3562_GRF_SYS_SOC_CON1 :
+				    RK3562_GRF_SYS_SOC_CON0;
+
+	return regmap_write(bsp_priv->grf, offset, val);
+}
+
+static int rk3562_init(struct rk_priv_data *bsp_priv)
+{
+	bool input = bsp_priv->clock_input;
+	u32 val;
+
+	if (bsp_priv->id == 0) {
+		val = input ? RK3562_GMAC0_CLK_SELECT_IO :
+			      RK3562_GMAC0_CLK_SELECT_CRU;
+		val |= RK3562_GMAC0_CLK_RMII_NOGATE;
+		regmap_write(bsp_priv->grf, RK3562_GRF_SYS_SOC_CON0, val);
+
+		val = input ? RK3562_GMAC0_IO_EXTCLK_SELECT_IO :
+			      RK3562_GMAC0_IO_EXTCLK_SELECT_CRU;
+		regmap_write(bsp_priv->php_grf, RK3562_GRF_IOC_GMAC_IOFUNC0_CON1, val);
+		regmap_write(bsp_priv->php_grf, RK3562_GRF_IOC_GMAC_IOFUNC1_CON1, val);
+	} else {
+		val = input ? RK3562_GMAC1_CLK_SELECT_IO :
+			      RK3562_GMAC1_CLK_SELECT_CRU;
+		val |= RK3562_GMAC1_CLK_RMII_NOGATE;
+		regmap_write(bsp_priv->grf, RK3562_GRF_SYS_SOC_CON1, val);
+
+		val = input ? RK3562_GMAC1_IO_EXTCLK_SELECT_IO :
+			      RK3562_GMAC1_IO_EXTCLK_SELECT_CRU;
+		regmap_write(bsp_priv->php_grf, RK3562_GRF_IOC_GMAC_IOFUNC1_CON1, val);
+	}
+
+	rk3562_dump_regs(bsp_priv, "after init");
+
+	return 0;
+}
